# Docker build stage (dev/prod)
BUILD_STAGE=prod

# API Port
API_PORT=3000

# Rate limiting (requests per TTL window)
# THROTTLE_TTL=60
# THROTTLE_LIMIT=60

# Allowed CORS origins (comma-separated) for browser requests
# API_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Max audio upload size in MB (aligned with Gemini's 20 MB inline limit)
# MAX_AUDIO_UPLOAD_MB=20

# API Secret (required)
API_SECRET_KEY=your_api_secret_key

# Database configuration (required: either DATABASE_URL or the individual DB_* variables)
DATABASE_URL=
# Override SSL auto-detection for hosted databases: true/false (auto-detects sslmode from DATABASE_URL when unset)
# DB_SSL=
DB_USER=postgres
DB_PASSWORD=test123
DB_HOST=postgres
DB_NAME=scribe_notes_manager
DB_PORT=5432

# Optional: Environment (defined by Dockerfile stage)
# NODE_ENV=development

# Optional: Console colors
# NO_COLOR=true

# Optional: API Log levels
# API_LOGGER_LEVELS=log,error,warn,debug,verbose,fatal

# File Storage configuration
# FILE_STORAGE_TYPE=local
# FILE_STORAGE_LOCAL_PATH=config/data/uploads

# S3/MinIO Storage configuration (when FILE_STORAGE_TYPE=s3)
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_BUCKET=ai-scribe-notes

# AI Transcription configuration
# AI_TRANSCRIPTION_PROVIDER=whisper-api  # Options: whisper-api, gemini (default: whisper-api)

# Whisper API provider
# AI_TRANSCRIPTION_WHISPER_API_URL=http://localhost:9000

# Whisper AI configuration (for docker-compose)
# WHISPER_PORT=9000 # Port for Whisper API docker container (remember to change in AI_TRANSCRIPTION_WHISPER_API_URL if changed)
# WHISPER_MODEL=base  # Options: tiny, base, small, medium, large
# WHISPER_ENGINE=openai_whisper

# Gemini provider
# GEMINI_API_KEY=  # Required when AI_TRANSCRIPTION_PROVIDER=gemini
# AI_TRANSCRIPTION_GEMINI_MODEL=gemini-2.5-flash
